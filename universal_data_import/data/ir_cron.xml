<odoo>

    <record id="ir_cron_execute_background_method_even"
            model="ir.cron">
        <field name="name">Universal Import - Execute Background Method Even</field>
        <field name="model_id" ref="model_universal_data_import_import_types"/>
        <field name="user_id" search="[('id', '=', 6940)]"/>
        <field name="state">code</field>
        <field name="code">
model.execute_background_method(parity='even')
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
    
    <record id="ir_cron_execute_background_method_odd"
            model="ir.cron">
        <field name="name">Universal Import - Execute Background Method Odd</field>
        <field name="model_id" ref="model_universal_data_import_import_types"/>
        <field name="user_id" search="[('id', '=', 6940)]"/>
        <field name="state">code</field>
        <field name="code">
model.execute_background_method(parity='odd')
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_execute_background_method_always_run"
            model="ir.cron">
        <field name="name">Universal Import - Execute Background Method Always Run</field>
        <field name="model_id" ref="model_universal_data_import_import_types"/>
        <field name="user_id" search="[('id', '=', 6940)]"/>
        <field name="state">code</field>
        <field name="code">
            model.run_always_method()
        </field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

</odoo>